<?xml version="1.0" encoding="utf-8"?>
<!-- 点演员弹出来的「他演过什么」。TMDB 查到啥就列啥，分电影、剧集两组，都是年份倒序。
     查不到（断网 / TMDB 没这个人 / 用户关了）就只留一句提示和「直接全站搜」那条退路。 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="@string/tmdb_loading"
            android:textColor="@color/white_50"
            android:textSize="@dimen/star_works_sub" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/movieTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp"
            android:text="@string/tmdb_movie"
            android:textColor="@color/white"
            android:textSize="@dimen/star_works_sub"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/movieList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp"
            android:text="@string/tmdb_tv"
            android:textColor="@color/white"
            android:textSize="@dimen/star_works_sub"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/tvList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/direct"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/selector_star_work"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:padding="12dp"
            android:text="@string/tmdb_direct_search"
            android:textColor="@color/white_50"
            android:textSize="@dimen/star_works_sub" />

    </LinearLayout>

</ScrollView>
