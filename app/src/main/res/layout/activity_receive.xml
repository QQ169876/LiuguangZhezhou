<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/receiveLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:keepScreenOn="true">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        app:use_controller="false" />

    <!-- 待机时盖在上面的提示：广播端还没来、或者它刚收工 -->
    <LinearLayout
        android:id="@+id/standby"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp">

        <TextView
            android:id="@+id/standbyText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/cast_receive_wait"
            android:textColor="@color/white"
            android:textSize="20sp" />

        <!-- 扫不到的时候，把「本机 IP / 扫了多少地址 / 几个回包」直接写在屏上：
             老盒子那类设备上不一定开着调试日志，这一行就是第一手证据 -->
        <TextView
            android:id="@+id/standbyInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:textColor="#B3FFFFFF"
            android:textSize="13sp"
            tools:text="本机 IP：192.168.3.20\n扫了 254 个地址，收到 0 个回包" />

        <EditText
            android:id="@+id/standbyInput"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/cast_receive_manual_hint"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:singleLine="true"
            android:textColor="@color/white"
            android:textColorHint="#88ffffff"
            android:textSize="16sp"
            android:visibility="visible" />

        <TextView
            android:id="@+id/standbyManual"
            style="@style/Control"
            android:layout_marginTop="12dp"
            android:focusable="true"
            android:text="@string/cast_receive_manual" />

    </LinearLayout>

    <!-- 顶栏：左边在接收什么，右边两个本地操作。没人动几秒就淡出去，跟播放器那一层一个做法 -->
    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/bg_cast_top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp"
        android:paddingBottom="26dp"
        android:visibility="invisible"
        tools:visibility="visible">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:shadowColor="#99000000"
                android:shadowRadius="6"
                android:singleLine="true"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:shadowColor="#99000000"
                android:shadowRadius="6"
                android:textColor="#CCFFFFFF"
                android:textSize="13sp"
                tools:text="中转链路 · 正在拉流…" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/rotate"
                style="@style/Control"
                android:focusable="true"
                android:text="@string/cast_receive_rotate" />

            <TextView
                android:id="@+id/exit"
                style="@style/Control"
                android:layout_marginTop="8dp"
                android:focusable="true"
                android:text="@string/cast_receive_exit" />

        </androidx.appcompat.widget.LinearLayoutCompat>

    </androidx.appcompat.widget.LinearLayoutCompat>

</FrameLayout>
